# Copy to .env.production on the production host and replace every example value.
# These values are intentionally non-production but internally consistent for CI smoke tests.
# Do not commit the real production file.
NODE_ENV=production
PUBLIC_ORIGIN=https://caravan.example.com
CARAVAN_HTTP_PORT=18081

POSTGRES_DB=caravan
POSTGRES_USER=caravan
POSTGRES_PASSWORD=caravan-example-password-change-me
# URL-encode special characters from the real database password in DATABASE_URL.
DATABASE_URL=postgresql://caravan:caravan-example-password-change-me@db:5432/caravan

# Fake token shape used only so the production runtime can boot in CI; replace it on the VPS.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
BOT_USERNAME=caravan_test_bot
TELEGRAM_WEBHOOK_SECRET=example_webhook_secret_change_me_0123456789abcdef

SESSION_HOURS=168
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TURN_TIMEOUT_SECONDS=60
RECONNECT_GRACE_SECONDS=30
MATCHMAKING_LEASE_SECONDS=90
CHALLENGE_TTL_SECONDS=900
REMATCH_TTL_SECONDS=900

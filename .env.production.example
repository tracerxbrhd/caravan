# Copy to .env.production on the production host and replace every replace-* value.
# Do not commit the real production file.
NODE_ENV=production
PUBLIC_ORIGIN=https://caravan.example.com
CARAVAN_HTTP_PORT=18081

POSTGRES_DB=caravan
POSTGRES_USER=caravan
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# URL-encode special characters from the database password in DATABASE_URL.
DATABASE_URL=postgresql://caravan:replace-with-url-encoded-password@db:5432/caravan

BOT_TOKEN=replace-with-a-real-telegram-bot-token
BOT_USERNAME=caravan_test_bot
TELEGRAM_WEBHOOK_SECRET=replace_with_high_entropy_url_safe_secret_at_least_32_chars

SESSION_HOURS=168
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TURN_TIMEOUT_SECONDS=60
RECONNECT_GRACE_SECONDS=30
MATCHMAKING_LEASE_SECONDS=90
CHALLENGE_TTL_SECONDS=900
REMATCH_TTL_SECONDS=900

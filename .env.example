# Local development only. Generate strong secrets for any non-local deployment.
NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
BOT_TOKEN=123456789:replace-with-a-real-telegram-bot-token
BOT_USERNAME=replace_with_bot_username
VITE_TELEGRAM_BOT_USERNAME=replace_with_bot_username
BOT_HOST=0.0.0.0
BOT_PORT=3001
TELEGRAM_WEBHOOK_SECRET=replace_with_high_entropy_webhook_secret_32_chars
SESSION_HOURS=168
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TURN_TIMEOUT_SECONDS=60
RECONNECT_GRACE_SECONDS=30
MATCHMAKING_LEASE_SECONDS=90
CHALLENGE_TTL_SECONDS=900
REMATCH_TTL_SECONDS=900
POSTGRES_DB=caravan
POSTGRES_USER=caravan
POSTGRES_PASSWORD=caravan-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://caravan:caravan-local@127.0.0.1:5432/caravan
